<%- include('./partials/header') %>
  <div class="min-h-screen px-6 md:px-16 py-10">
    <h1 class="text-3xl font-bold mb-8">Your Cart</h1>
    <% if (!user.cart || user.cart.length===0) { %>
      <p class="text-gray-600">Your cart is empty. <a class="text-blue-600 underline" href="/shop">Continue shopping</a>
      </p>
      <% } else { %>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="lg:col-span-2 space-y-5">
            <% user.cart.forEach(function(item) { %>
              <div class="flex gap-5 rounded-lg shadow p-4">
                <div class="w-32 h-32 flex-shrink-0 flex items-center justify-center rounded"
                  style=`background-color: <%= item.bgcolor || '#f3f4f6' %>`>
                  <% if (item.image) { %>
                      <img class="max-h-28 object-contain"
                      src="data:image/jpeg;base64,<%= item.image.toString('base64') %>" alt="<%= item.name %>">
                    <% } %>
                </div>
                <div class="flex-1">
                  <h2 class="text-xl font-semibold">
                    <%= item.name %>
                  </h2>
                  <p class="mt-2">Price: ₹ <%= Number(item.price || 0).toFixed(2) %>
                  </p>
                  <p>Discount: ₹ <%= Number(item.discount || 0).toFixed(2) %>
                  </p>
                  <p class="font-semibold mt-2">Net: ₹ <%= (Number(item.price || 0) - Number(item.discount ||
                      0)).toFixed(2) %>
                  </p>
                </div>
              </div>
              <% }) %>
          </div>
          <aside class="rounded-lg shadow p-6 h-fit">
            <h2 class="text-xl font-semibold mb-5">Price Breakdown</h2>
            <div class="flex justify-between mb-3"><span>Items total (after discount)</span><span>₹ <%=
                  Number(subtotal).toFixed(2) %></span></div>
            <div class="flex justify-between mb-3"><span>Platform fee</span><span>₹ <%= user.cart.length ? '20.00'
                  : '0.00' %></span></div>
            <div class="flex justify-between mb-3"><span>Shipping</span><span>FREE</span></div>
            <hr class="my-4">
            <div class="flex justify-between text-lg font-bold"><span>Total</span><span>₹ <%= Number(bill).toFixed(2) %>
                  </span></div>
            <a href="/shop" class="block text-center mt-6 rounded bg-blue-600 text-white px-4 py-3">Continue
              shopping</a>
          </aside>
        </div>
        <% } %>
  </div>
  <%- include('./partials/footer') %>