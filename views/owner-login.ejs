<%- include('./partials/header') %>
<div class="min-h-screen flex items-center justify-center px-6">
    <div class="w-full max-w-md bg-white p-8 rounded-lg shadow">
        <h1 class="text-3xl font-semibold mb-2">Admin Login</h1>
        <p class="text-gray-600 mb-6">Sign in to manage your Scatch products.</p>

        <% if (error && error.length) { %>
            <div class="mb-4 rounded bg-red-100 text-red-700 p-3"><%= error %></div>
        <% } %>
        <% if (success && success.length) { %>
            <div class="mb-4 rounded bg-green-100 text-green-700 p-3"><%= success %></div>
        <% } %>

        <form action="/owners/login" method="post" autocomplete="off">
            <label class="block mb-1" for="email">Email</label>
            <input id="email" class="block bg-zinc-100 w-full px-3 py-2 border rounded-md mb-4"
                   type="email" name="email" required autocomplete="username">

            <label class="block mb-1" for="password">Password</label>
            <input id="password" class="block bg-zinc-100 w-full px-3 py-2 border rounded-md mb-5"
                   type="password" name="password" required autocomplete="current-password">

            <button class="w-full rounded-md py-3 bg-blue-600 text-white" type="submit">Login</button>
        </form>
    </div>
</div>
<%- include('./partials/footer') %>
