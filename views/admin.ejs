<%- include('./partials/header') %>

<div class="min-h-screen px-6 md:px-16 py-10">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold">All Products</h1>
            <p class="text-gray-600">Admin: <%= owner.email %></p>
        </div>
        <div class="flex items-center gap-4">
            <a href="/owners/admin" class="text-blue-600 underline">Create New Product</a>
            <form action="/owners/logout" method="post">
                <button class="rounded bg-zinc-800 text-white px-4 py-2" type="submit">Logout</button>
            </form>
        </div>
    </div>

    <% if (success && success.length) { %>
        <div class="mb-5 p-3 rounded bg-green-100 text-green-800"><%= success %></div>
    <% } %>
    <% if (error && error.length) { %>
        <div class="mb-5 p-3 rounded bg-red-100 text-red-800"><%= error %></div>
    <% } %>

    <% if (!products || products.length === 0) { %>
        <p class="text-gray-600">No products have been created yet.</p>
    <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% products.forEach(function(product) { %>
                <div class="rounded overflow-hidden shadow">
                    <div class="h-52 flex items-center justify-center" style=`background-color: <%= product.bgcolor || '#f3f4f6' %>;`}>
                        <% if (product.image) { %>
                            <img class="h-44 object-contain" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                        <% } %>
                    </div>
                    <div class="px-4 py-4" style=`background-color: <%= product.panelcolor || '#111827' %>; color: <%= product.textcolor || '#ffffff' %>;`}>
                        <h2 class="font-semibold"><%= product.name %></h2>
                        <p>₹ <%= product.price %></p>
                        <p class="text-sm">Discount: ₹ <%= product.discount || 0 %></p>
                        <form action="/owners/products/<%= product._id %>/delete" method="POST" class="mt-4"
                              onsubmit="return confirm('Are you sure you want to delete this product?');">
                            <button type="submit" class="rounded bg-red-600 hover:bg-red-700 text-white px-4 py-2">
                                Delete Product
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('./partials/footer') %>
